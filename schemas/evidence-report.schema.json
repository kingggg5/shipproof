{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kingggg5/shipproof/schemas/evidence-report.schema.json",
  "title": "ShipProof optional analyzer evidence report",
  "allOf": [
    { "$ref": "evidence-envelope.schema.json" },
    {
      "type": "object",
      "required": ["root", "adapter", "analyzer", "process_exit_code", "passed", "diagnostics"],
      "properties": {
        "tool": { "properties": { "command": { "const": "evidence" } } },
        "root": { "type": "string", "minLength": 1 },
        "adapter": { "enum": ["typescript", "go", "rust"] },
        "analyzer": { "type": "string", "minLength": 1 },
        "process_exit_code": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    }
  ],
  "unevaluatedProperties": false
}
