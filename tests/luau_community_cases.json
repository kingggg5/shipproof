    {
      "rule_id": "SP708",
      "expected_severity": "medium",
      "expected_confidence": "high",
      "blocking_eligible": false,
      "false_positive_analysis": "Advisory: visible unshadowed globals and decimal signed-32-bit integer limits only. Equal/ordered limits, computed values, floats, aliases and changed environments stay silent. Not a general numeric analyzer.",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/luau-lang/luau/master/VM/src/lmathlib.cpp",
          "claim": "The native math implementations require ordered limits; equality is valid and reversed random limits produce an empty interval."
        },
        {
          "url": "https://www.reddit.com/r/robloxgamedev/comments/zc7up9/",
          "claim": "2022 discovery lead: reversed negative random limits cause an interval error. Owning source, not comments, establishes the rule."
        },
        {
          "url": "https://devforum.roblox.com/t/playermodulecameramoduletransparencycontroller-invalid-argument-3-to-clamp/1131588",
          "claim": "2021 discovery lead: reversed clamp limits break a camera path; runtime source confirms the API boundary."
        },
        {
          "url": "https://cwe.mitre.org/data/definitions/682.html",
          "claim": "Maps the local API/state boundary; not a deployed exploitation or recall assertion."
        }
      ],
      "positive": [
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,10,2)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(10,2)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(-3,-8)"
        },
        {
          "path": "module.luau",
          "source": "return math.clamp(value,-1,-8)"
        },
        {
          "path": "module.luau",
          "source": "return math.clamp(0,5,4)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(2,1)"
        }
      ],
      "negative": [
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,2,10)"
        },
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,2,2)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(1,1)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(-8,-3)"
        },
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,low,high)"
        },
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,10.5,2.5)"
        },
        {
          "path": "module.luau",
          "source": "local value=custom.clamp(input,10,2)"
        },
        {
          "path": "module.luau",
          "source": "local math=customMath\nlocal value=math.clamp(input,10,2)"
        },
        {
          "path": "module.luau",
          "source": "return math.random(9007199254740991,2)"
        },
        {
          "path": "module.luau",
          "source": "local random=math.random\nreturn random(10,2)"
        }
      ],
      "adversarial": [
        {
          "path": "module.luau",
          "source": "-- local value=math.clamp(input,10,2)",
          "expected": false,
          "rationale": "A commented invalid-range example cannot invoke a native numeric API."
        },
        {
          "path": "module.luau",
          "source": "local text=[=[local value=math.clamp(input,10,2)]=]",
          "expected": false,
          "rationale": "A long literal is data and cannot establish an invalid numeric invocation."
        },
        {
          "path": "module.luau",
          "source": "local function f(math) local value=math.clamp(input,10,2) end",
          "expected": false,
          "rationale": "A function parameter shadows the native math table and invalidates API identity."
        },
        {
          "path": "module.luau",
          "source": "math.clamp=customClamp\nlocal value=math.clamp(input,10,2)",
          "expected": false,
          "rationale": "A changed library member must not be presumed to use the native bounds contract."
        },
        {
          "path": "module.luau",
          "source": "local value=math.clamp(input,10,-- bound\n2)",
          "expected": true,
          "rationale": "An intervening comment does not change the order of literal integer bounds."
        }
      ]
    },
