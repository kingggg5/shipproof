      "rule_id": "SP710",
      "expected_severity": "medium",
      "expected_confidence": "high",
      "blocking_eligible": false,
      "false_positive_analysis": "Advisory: direct freeze of a table literal or a unique same-region local binding, then top-level assignment. Nested mutable children, clones, escapes, reassignments and ambiguous scopes stay unresolved. No deep-freeze claim.",
      "sources": [
